# Copy to .env.local. This file is never included in the production build.
# Local terrain is the default and requires no network or credentials.
ASTRA_TERRAIN_PROVIDER=procedural

# Real elevation: public Terrarium DEM tiles, no API token required.
# ASTRA_TERRAIN_PROVIDER=terrarium
# ASTRA_TERRAIN_LATITUDE=46.577
# ASTRA_TERRAIN_LONGITUDE=10.718
# ASTRA_TERRAIN_ZOOM=14
# ASTRA_TERRAIN_TIMEOUT=6500
# ASTRA_TERRAIN_CACHE_SIZE=48

# Optional custom Terrarium-compatible tile service.
# ASTRA_TERRAIN_URL=https://example.com/terrain/{z}/{x}/{y}.png
# ASTRA_TERRAIN_TOKEN=
