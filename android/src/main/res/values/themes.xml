<resources>
    <!-- The launch splash and the frame before the page paints share the
         loading screen's colour, so the game fades in without a flash. -->
    <style name="Theme.Astra" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/astra_night</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
